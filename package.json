{
  "name": "opencrlset",
  "version": "0.1.0",
  "private": true,
  "description": "Transparent, reproducible CRLSets and revocation data built from open sources",
  "license": "AGPL-3.0-or-later",
  "bin": {
    "opencrlset": "src/cli.ts"
  },
  "type": "module",
  "exports": {
    "./policy": "./src/policy.ts",
    "./reasons": "./src/reasons.ts",
    "./explorer-format": "./src/explorer-format.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "node --test 'test/**/*.test.ts'",
    "cli": "node src/cli.ts",
    "site": "pnpm --filter opencrlset-site"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "fflate": "^0.8.3",
    "pbf": "^5.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.15.0"
}
